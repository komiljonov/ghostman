# Ghostman configuration. Copy this file to .env and adjust as needed:
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
#
# .env is read by two consumers:
#   - go-task (loads it into the environment of every task, including `task dev`)
#   - docker compose (substitutes the POSTGRES_* values into docker-compose.yml)

# --- Server -----------------------------------------------------------------

# PostgreSQL connection string used by pgxpool.
# Host-side default matches the docker-compose service published on 5432.
DATABASE_URL=postgres://ghostman:ghostman@localhost:5432/ghostman?sslmode=disable

# TCP port the HTTP server listens on.
PORT=8080

# Runtime profile: "dev" (human-readable text logs) or "prod" (JSON logs).
ENV=dev

# Minimum log level: debug, info, warn or error.
LOG_LEVEL=debug

# --- Database container (docker-compose only) -------------------------------
# Keep these in sync with the credentials embedded in DATABASE_URL above.

POSTGRES_USER=ghostman
POSTGRES_PASSWORD=ghostman
POSTGRES_DB=ghostman

# --- Deployment (task upload only) ------------------------------------------
# `task upload` copies dist/ghostman-server into DEPLOY_DIR on this server. The
# host must already be in ~/.ssh/known_hosts: connect once with ssh first.
# Real credentials belong in .env (gitignored), never in this file.

DEPLOY_HOST=api.ghostman.uz
DEPLOY_PORT=22
DEPLOY_USER=
DEPLOY_PASSWORD=
DEPLOY_DIR=
